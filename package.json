{
  "name": "openskill-manager",
  "version": "1.1.5",
  "description": "跨平台 AI 技能管理工具 - 统一管理 OpenClaw、QClaw 等平台的技能",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm run electron:compile\" \"npm run electron:start\"",
    "electron:compile": "webpack --config webpack.electron.config.js --watch",
    "electron:start": "wait-on dist/electron/main.js && electron .",
    "react:dev": "webpack serve --config webpack.react.config.js",
    "react:build": "webpack --config webpack.react.config.js --mode production",
    "electron:build": "webpack --config webpack.electron.config.js",
    "copy-preload": "cp src/electron/preload.js dist/electron/preload.js",
    "build": "npm run react:build && npm run electron:build && npm run copy-preload",
    "pack": "npm run build",
    "dist": "npm run build && NODE_OPTIONS='--max-old-space-size=4096' electron-builder --config.compression=maximum",
    "dist:store": "npm run build && electron-builder --config.compression=store"
  },
  "keywords": [
    "skill",
    "manager",
    "openclaw",
    "qclaw",
    "ai",
    "electron"
  ],
  "author": "Bo <boge@example.com>",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.23.7",
    "@babel/preset-env": "^7.23.7",
    "@babel/preset-react": "^7.23.3",
    "@babel/preset-typescript": "^7.23.3",
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "adm-zip": "^0.5.17",
    "archiver": "^8.0.0",
    "babel-loader": "^9.1.3",
    "chokidar": "^3.5.3",
    "concurrently": "^8.2.2",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^6.9.1",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "fs-extra": "^11.2.0",
    "html-webpack-plugin": "^5.6.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "semver": "^7.5.4",
    "style-loader": "^3.3.3",
    "typescript": "^5.3.3",
    "wait-on": "^7.2.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  },
  "build": {
    "appId": "com.openskill.manager",
    "productName": "OpenSkill Manager",
    "publish": [
      {
        "provider": "github",
        "owner": "boboloveic",
        "repo": "openskill-manager"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "icon": "assets/icon.png",
      "category": "Development"
    }
  }
}
